; Energy minimization — steepest descent
integrator              = steep
nsteps                  = 100000
emtol                   = 10.0
emstep                  = 0.01

; Neighbor searching
cutoff-scheme           = Verlet
nstlist                 = 10
ns_type                 = grid
pbc                     = xyz

; Electrostatics and VdW
coulombtype             = PME
rcoulomb                = 1.0
vdwtype                 = Cut-off
rvdw                    = 1.0
DispCorr                = EnerPres

; No constraints during minimization
constraints             = none
