# Snakefile — MD pipeline: PDB prep + MD preprocessing + production MD
#
# Covers:
#   PDB structure
#     -> extract chains (Python)                       } PDB prep
#     -> vacuum minimize (OpenMM, GPU)
#     -> PDB2PQR pH 7 protonation
#     -> pdb2gmx AMBER99SB-ILDN
#     -> editconf (triclinic, 1.2 nm)
#     -> solvate (TIP3P)                               } MD preprocessing
#     -> genion (0.15 M NaCl, neutral)
#     -> GROMACS EM (steepest descent)
#     -> NVT equilibration (100 ps)
#     -> NPT equilibration (100 ps)
#     -> production MD (md_ns / md_steps, GPU)         } production MD
#
# Run from this directory (run_MD/):
#   snakemake --configfile config.yaml -n                       # dry-run
#   snakemake --configfile config.yaml --cores 32 --resources gpu=<n>
#   snakemake --configfile config.yaml --cores 8 --resources gpu=1 \
#       <output_dir>/MD/<system>/md.gro                         # single system
#
# Input:
#   - config.yaml: parameters. `output_dir` is the object-storage destination
#     the preprocessing tree is synced to (rule sync_preprocessing); blank
#     skips the sync.
#   - a structures file (config key `structures_file`, default structures.yaml):
#     top-level `base_dir` (+ optional top-level `output_dir` replacing
#     "results") and one {name, path} entry per structure to run MD on, with
#     optional per-structure `chains`, `output_dir` and `md_ns`/`md_steps`
#     (overrides the global default). See scripts/build_systems.py.
#
# Output layout — each system gets its own directory (default
# {base_dir}/results/{name}/, overridable per structure):
#   {system_dir}/preprocessing/   — chain extraction through NPT equilibration
#   {system_dir}/MD/              — production MD (md.mdp, md.tpr, md.gro, ...)
#   {system_dir}/movie.mp4        — trajectory movie (rule movie)
#   {results_root}/manifest.json  — parsed system manifest (audit)
#
# GPU: openmm_minimize and production_md each request 1 GPU (resources: gpu=1).
# Launch under Slurm so each job is allocated its own GPU; GROMACS/OpenMM pick
# up the allocated device via CUDA_VISIBLE_DEVICES.

import re
import sys
from pathlib import Path

sys.path.insert(0, "scripts")
from build_systems import build_systems, load_structures

configfile: "config.yaml"

CPU_THREADS = int(config.get("cpu_threads", 8))

PDB2PQR        = config.get("pdb2pqr_bin", "pdb2pqr")
GMX_PYTHON     = config.get("gmx_python_bin", "python3")
PYMOL_PYTHON   = config.get("pymol_python_bin", "python")
OPENMM_PYTHON  = config.get("openmm_python_bin", "python")
S5CMD          = config.get("s5cmd_bin", "s5cmd")
OUTPUT_DEST    = config.get("output_dir", "").rstrip("/")  # object-storage sync destination
MDP_MD_BASE    = config.get("mdp_md", "mdp/md.mdp")

MAKE_MOVIE     = config.get("make_movie", True)
if isinstance(MAKE_MOVIE, str):
    MAKE_MOVIE = MAKE_MOVIE.strip().lower() not in ("false", "0", "no", "off", "")

# One MD system per structures-list entry. Each carries exactly one of
# md_ns / md_steps (per-structure override, else the global default) and its
# own output_dir; build_systems raises if any system ends up with neither
# length.
SYSTEMS, RESULTS_ROOT = build_systems(
    load_structures(config),
    default_md_ns=config.get("md_ns"),
    default_md_steps=config.get("md_steps"),
)
if not SYSTEMS:
    raise ValueError("No systems parsed — check the structures list.")

# Every rule output lives under a system's output dir, so the dir itself is the
# wildcard ({sysdir}). Constrain it to the exact set of system dirs (like a
# lookup table) so wildcard matching never picks up unrelated files, and make
# sure no two systems share one.
from collections import Counter
_dupes = [d for d, n in Counter(v["output_dir"] for v in SYSTEMS.values()).items()
          if n > 1]
if _dupes:
    raise ValueError(f"systems share an output_dir: {sorted(_dupes)}")
OUT2SYS = {v["output_dir"]: k for k, v in SYSTEMS.items()}
wildcard_constraints:
    sysdir = "(?:" + "|".join(re.escape(d) for d in OUT2SYS) + ")",

SYSTEM_DIRS = list(OUT2SYS)


def sys_data(wc) -> dict:
    return SYSTEMS[OUT2SYS[wc.sysdir]]


# ---------------------------------------------------------------------------
# Target
# ---------------------------------------------------------------------------

_TARGETS = [f"{d}/MD/md.gro" for d in SYSTEM_DIRS]
if MAKE_MOVIE:
    _TARGETS += [f"{d}/movie.mp4" for d in SYSTEM_DIRS]


rule all:
    input:
        _TARGETS,
        str(RESULTS_ROOT / "manifest.json"),


# ---------------------------------------------------------------------------
# Step 0 — Write the parsed system manifest to disk (for inspection/audit)
# ---------------------------------------------------------------------------

rule write_manifest:
    output:
        json = str(RESULTS_ROOT / "manifest.json"),
    run:
        import json
        with open(output.json, "w") as fh:
            json.dump(SYSTEMS, fh, indent=2)


# ---------------------------------------------------------------------------
# Step 0b — Production .mdp per system, with that system's run length
# (per-structure md_ns / md_steps, else the global default)
# ---------------------------------------------------------------------------

rule write_md_mdp:
    input:
        base = MDP_MD_BASE,
    output:
        mdp = "{sysdir}/MD/md.mdp",
    params:
        length = lambda wc: (
            f"--ns {sys_data(wc)['md_ns']}" if sys_data(wc)["md_ns"] is not None
            else f"--steps {sys_data(wc)['md_steps']}"),
    log:
        "{sysdir}/MD/logs/write_md_mdp.log",
    shell:
        """
        {GMX_PYTHON} scripts/make_md_mdp.py \
            {input.base} {output.mdp} {params.length} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Step 1 — Extract the relevant chains from the input PDB (PDB prep)
# ---------------------------------------------------------------------------

rule extract_chains:
    input:
        pdb = lambda wc: sys_data(wc)["pdb_file"],
    output:
        pdb = "{sysdir}/preprocessing/extracted.pdb",
    params:
        chains = lambda wc: " ".join(sys_data(wc)["chains"]),
    log:
        "{sysdir}/preprocessing/logs/extract_chains.log",
    shell:
        """
        {GMX_PYTHON} scripts/extract_chains.py \
            {input.pdb} {output.pdb} {params.chains} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Step 2 — OpenMM vacuum energy minimization, GPU (MD preprocessing)
# ---------------------------------------------------------------------------

rule openmm_minimize:
    input:
        pdb = "{sysdir}/preprocessing/extracted.pdb",
    output:
        pdb = "{sysdir}/preprocessing/minimized.pdb",
    resources:
        gpu = 1,
    log:
        "{sysdir}/preprocessing/logs/openmm_minimize.log",
    shell:
        """
        {OPENMM_PYTHON} scripts/minimize_openmm.py \
            {input.pdb} {output.pdb} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Step 3 — PDB2PQR: PROPKA protonation at pH 7 (MD preprocessing)
# ---------------------------------------------------------------------------

rule pdb2pqr:
    input:
        pdb = "{sysdir}/preprocessing/minimized.pdb",
    output:
        pdb = "{sysdir}/preprocessing/protonated.pdb",
        pqr = "{sysdir}/preprocessing/protonated.pqr",
    log:
        "{sysdir}/preprocessing/logs/pdb2pqr.log",
    shell:
        """
        {PDB2PQR} \
            --ff AMBER \
            --with-ph 7.0 \
            --titration-state-method propka \
            --pdb-output {output.pdb} \
            {input.pdb} {output.pqr} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Step 4 — GROMACS topology (pdb2gmx, AMBER99SB-ILDN + TIP3P) (MD preprocessing)
# ---------------------------------------------------------------------------

rule pdb2gmx:
    input:
        pdb = "{sysdir}/preprocessing/protonated.pdb",
    output:
        gro = "{sysdir}/preprocessing/protein.gro",
        top = "{sysdir}/preprocessing/topol_base.top",
    log:
        "{sysdir}/preprocessing/logs/pdb2gmx.log",
    shell:
        """
        ROOT=$(pwd)
        cd $(dirname {output.gro})
        gmx pdb2gmx \
            -f protonated.pdb \
            -o protein.gro \
            -p topol_base.top \
            -ff amber99sb-ildn \
            -water tip3p \
            -ignh \
            >> "$ROOT/{log}" 2>&1
        """


# ---------------------------------------------------------------------------
# Step 5 — Simulation box (triclinic, principal-axis aligned, 1.2 nm padding)
# ---------------------------------------------------------------------------

rule editconf:
    input:
        gro = "{sysdir}/preprocessing/protein.gro",
    output:
        gro = "{sysdir}/preprocessing/boxed.gro",
    log:
        "{sysdir}/preprocessing/logs/editconf.log",
    shell:
        """
        printf 'Protein\n' | gmx editconf \
            -f {input.gro} \
            -o {output.gro} \
            -princ -c -d 1.2 -bt triclinic \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Step 6 — Solvation (TIP3P water)
# ---------------------------------------------------------------------------

rule solvate:
    input:
        gro = "{sysdir}/preprocessing/boxed.gro",
        top = "{sysdir}/preprocessing/topol_base.top",
    output:
        gro = "{sysdir}/preprocessing/solvated.gro",
        top = "{sysdir}/preprocessing/topol_solv.top",
    log:
        "{sysdir}/preprocessing/logs/solvate.log",
    shell:
        """
        cp {input.top} {output.top}
        gmx solvate \
            -cp {input.gro} \
            -cs spc216.gro \
            -o {output.gro} \
            -p {output.top} \
            > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# Step 7 — Neutralization + 0.15 M NaCl
# ---------------------------------------------------------------------------

rule genion:
    input:
        gro = "{sysdir}/preprocessing/solvated.gro",
        top = "{sysdir}/preprocessing/topol_solv.top",
        mdp = "mdp/em_strong.mdp",
    output:
        gro = "{sysdir}/preprocessing/ions.gro",
        top = "{sysdir}/preprocessing/topol_ions.top",
        tpr = "{sysdir}/preprocessing/ions.tpr",
    log:
        "{sysdir}/preprocessing/logs/genion.log",
    shell:
        """
        cp {input.top} {output.top}
        ROOT=$(pwd)
        cd $(dirname {output.gro})
        gmx grompp \
            -f "$ROOT/{input.mdp}" \
            -c "$ROOT/{input.gro}" \
            -p topol_ions.top \
            -o ions.tpr \
            -maxwarn 1 \
            >> "$ROOT/{log}" 2>&1
        printf 'SOL' | gmx genion \
            -s ions.tpr \
            -o ions.gro \
            -p topol_ions.top \
            -pname NA -nname CL \
            -neutral -conc 0.15 \
            >> "$ROOT/{log}" 2>&1
        """


# ---------------------------------------------------------------------------
# Step 8 — GROMACS energy minimization (steepest descent, CPU)
# ---------------------------------------------------------------------------

rule gromacs_em:
    input:
        gro = "{sysdir}/preprocessing/ions.gro",
        top = "{sysdir}/preprocessing/topol_ions.top",
        mdp = "mdp/em_strong.mdp",
    output:
        gro = "{sysdir}/preprocessing/em.gro",
        tpr = "{sysdir}/preprocessing/em.tpr",
    threads: CPU_THREADS
    log:
        "{sysdir}/preprocessing/logs/em.log",
    shell:
        """
        ROOT=$(pwd)
        cd $(dirname {output.gro})
        gmx grompp \
            -f "$ROOT/{input.mdp}" \
            -c ions.gro \
            -p topol_ions.top \
            -o em.tpr \
            -maxwarn 0 \
            >> "$ROOT/{log}" 2>&1
        gmx mdrun \
            -v -deffnm em \
            -ntmpi 1 -ntomp {threads} \
            >> "$ROOT/{log}" 2>&1
        """


# ---------------------------------------------------------------------------
# Step 9 — NVT equilibration (100 ps, position-restrained, CPU)
# ---------------------------------------------------------------------------

rule nvt:
    input:
        gro = "{sysdir}/preprocessing/em.gro",
        top = "{sysdir}/preprocessing/topol_ions.top",
        mdp = "mdp/nvt.mdp",
    output:
        gro = "{sysdir}/preprocessing/nvt.gro",
        cpt = "{sysdir}/preprocessing/nvt.cpt",
        tpr = "{sysdir}/preprocessing/nvt.tpr",
    threads: CPU_THREADS
    log:
        "{sysdir}/preprocessing/logs/nvt.log",
    shell:
        """
        ROOT=$(pwd)
        cd $(dirname {output.gro})
        gmx grompp \
            -f "$ROOT/{input.mdp}" \
            -c em.gro \
            -r em.gro \
            -p topol_ions.top \
            -o nvt.tpr \
            -maxwarn 0 \
            >> "$ROOT/{log}" 2>&1
        gmx mdrun \
            -v -deffnm nvt \
            -ntmpi 1 -ntomp {threads} \
            >> "$ROOT/{log}" 2>&1
        """


# ---------------------------------------------------------------------------
# Step 10 — NPT equilibration (100 ps, position-restrained, CPU)
#
#  This is the last step of "preprocessing" — npt.gro/.cpt is the fully
#  equilibrated system, ready for production MD.
# ---------------------------------------------------------------------------

rule npt:
    input:
        gro = "{sysdir}/preprocessing/nvt.gro",
        cpt = "{sysdir}/preprocessing/nvt.cpt",
        top = "{sysdir}/preprocessing/topol_ions.top",
        mdp = "mdp/npt.mdp",
    output:
        gro = "{sysdir}/preprocessing/npt.gro",
        cpt = "{sysdir}/preprocessing/npt.cpt",
        tpr = "{sysdir}/preprocessing/npt.tpr",
    threads: CPU_THREADS
    log:
        "{sysdir}/preprocessing/logs/npt.log",
    shell:
        """
        ROOT=$(pwd)
        cd $(dirname {output.gro})
        gmx grompp \
            -f "$ROOT/{input.mdp}" \
            -c nvt.gro \
            -r nvt.gro \
            -t nvt.cpt \
            -p topol_ions.top \
            -o npt.tpr \
            -maxwarn 0 \
            >> "$ROOT/{log}" 2>&1
        gmx mdrun \
            -v -deffnm npt \
            -ntmpi 1 -ntomp {threads} \
            >> "$ROOT/{log}" 2>&1
        """


# ---------------------------------------------------------------------------
# Checkpoint — sync every system's preprocessing/ tree to object storage once
# it has reached npt.gro (and only when every system has). Every production_md
# job waits on this. config.yaml `output_dir` is the destination; blank = skip.
# ---------------------------------------------------------------------------

rule sync_preprocessing:
    input:
        [f"{v['output_dir']}/preprocessing/npt.gro" for v in SYSTEMS.values()],
    output:
        touch(str(RESULTS_ROOT / "preprocessing.synced")),
    params:
        dest  = OUTPUT_DEST,
        pairs = "\n".join(f"{v['output_dir']}/preprocessing {k}"
                         for k, v in SYSTEMS.items()),
    log:
        str(RESULTS_ROOT / "logs" / "sync_preprocessing.log"),
    shell:
        """
        mkdir -p $(dirname {log})
        if [ -z "{params.dest}" ]; then
            echo "output_dir not set in config.yaml — skipping object-storage sync" | tee {log}
        else
            while read -r src name; do
                [ -n "$src" ] || continue
                {S5CMD} sync "$src/" "{params.dest}/$name/preprocessing/" >> {log} 2>&1
            done <<'PAIRS'
{params.pairs}
PAIRS
        fi
        """


# ---------------------------------------------------------------------------
# Step 11 — Production MD (length from md_ns / md_steps, GPU-accelerated)
# ---------------------------------------------------------------------------

rule production_md:
    input:
        gro    = "{sysdir}/preprocessing/npt.gro",
        cpt    = "{sysdir}/preprocessing/npt.cpt",
        top    = "{sysdir}/preprocessing/topol_ions.top",
        mdp    = "{sysdir}/MD/md.mdp",
        synced = str(RESULTS_ROOT / "preprocessing.synced"),
    output:
        gro = "{sysdir}/MD/md.gro",
        xtc = "{sysdir}/MD/md.xtc",
        tpr = "{sysdir}/MD/md.tpr",
    threads: CPU_THREADS
    resources:
        gpu = 1,
    log:
        "{sysdir}/MD/logs/md.log",
    shell:
        """
        ROOT=$(pwd)
        PREDIR=$(dirname {input.top})
        MDDIR=$(dirname {output.gro})
        TPR="$ROOT/$MDDIR/md.tpr"

        if [ ! -f "$TPR" ]; then
            cd "$PREDIR"
            gmx grompp \
                -f "$ROOT/{input.mdp}" \
                -c npt.gro \
                -t npt.cpt \
                -p topol_ions.top \
                -o "$TPR" \
                -maxwarn 0 \
                >> "$ROOT/{log}" 2>&1
            cd "$ROOT"
        fi

        cd "$MDDIR"
        CPI=""
        [ -f md.cpt ] && CPI="-cpi md.cpt"
        gmx mdrun \
            -v -deffnm md \
            -s md.tpr \
            $CPI \
            -ntmpi 1 -ntomp {threads} \
            -nb gpu -pme gpu -bonded gpu -update gpu \
            >> "$ROOT/{log}" 2>&1
        """


# ---------------------------------------------------------------------------
# Step 12 — Trajectory movie (solute only: strips water + ions, keeps protein
# and any glycans/ligands). trjconv makes molecules whole & centers, PyMOL
# ray-traces each frame, ffmpeg encodes to mp4.
# ---------------------------------------------------------------------------

rule movie:
    input:
        xtc = "{sysdir}/MD/md.xtc",
        tpr = "{sysdir}/MD/md.tpr",
    output:
        mp4 = "{sysdir}/movie.mp4",
    params:
        skip = int(config.get("movie_skip", 1)),
        fps  = int(config.get("movie_fps", 15)),
    log:
        "{sysdir}/MD/logs/movie.log",
    shell:
        """
        MP4="{output.mp4}"
        STEM="${{MP4%.mp4}}"          # per-system scratch prefix (unique)
        FRAMES="$STEM.frames"
        NDX="$STEM.solute.ndx"
        SOLPDB="$STEM.solute.pdb"
        rm -rf "$FRAMES"

        # Solute = everything except water (SOL) and ions (NA/CL); keeps glycans.
        # Single unnamed group -> index 0 in the .ndx.
        gmx select -s {input.tpr} \
            -on "$NDX" \
            -select 'not resname SOL NA CL' \
            > {log} 2>&1

        # Strip solvent/ions, make molecules whole, center; optionally decimate.
        # Feed group 0 twice: centering group, then output group.
        {{ echo 0; echo 0; }} | gmx trjconv \
            -s {input.tpr} -f {input.xtc} -n "$NDX" \
            -o "$SOLPDB" \
            -pbc mol -center -skip {params.skip} \
            >> {log} 2>&1

        {PYMOL_PYTHON} scripts/render_movie.py \
            "$SOLPDB" "$FRAMES" \
            >> {log} 2>&1

        ffmpeg -y -framerate {params.fps} -i "$FRAMES/frame_%04d.png" \
            -c:v libx264 -pix_fmt yuv420p \
            -vf 'scale=trunc(iw/2)*2:trunc(ih/2)*2' \
            {output.mp4} >> {log} 2>&1

        rm -rf "$FRAMES" "$SOLPDB" "$NDX"
        """
